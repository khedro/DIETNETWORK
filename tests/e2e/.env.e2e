# Env for the browser simulation (tests/e2e/run.sh). Dummy secrets are fine:
# this stack is ephemeral and bound to loopback. Production-like wherever a
# browser can tell the difference: HTTPS, secure cookies, raw upload deleted
# after success, default concurrency caps.
POSTGRES_DB=dietnet_e2e
POSTGRES_USER=dietnet_e2e
POSTGRES_PASSWORD=e2e-only-not-a-secret
JWT_SECRET=e2e-only-not-a-secret-jwt
DATA_HOST_PATH=./tests/e2e/.work/volumes

ENVIRONMENT=production
COOKIE_SECURE=true
BASE_URL=https://localhost:18443
FRONTEND_URL=https://localhost:18443
PUBLIC_API_BASE_URL=https://localhost:18443/api

# Cloudflare's public always-pass test key: the widget loads and runs in the
# browser for real, but the backend doesn't verify the token.
CAPTCHA_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_STARTTLS=false

DELETE_RAW_AFTER_SUCCESS=true
